# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string.
# No separate DB API key is required; use the Neon connection string directly.
# Use sslmode=verify-full (not require): pg currently treats `require` as
# `verify-full` under the hood and prints a deprecation warning on every
# boot; pg 9.0 / pg-connection-string 3.0 will switch `require` to libpq
# semantics (weaker: no chain or hostname check). `verify-full` locks in
# the current strong behavior and silences the warning. Neon uses valid
# CA-signed certs so hostname verification succeeds.
# Example: postgresql://user:password@host/dbname?sslmode=verify-full
DATABASE_URL="postgresql://user:password@ep-example-host.region.aws.neon.tech/neondb?sslmode=verify-full"

# PORT: Express backend port (proxied by Vite in dev).
PORT=3001

# DIGIKEY_CLIENT_ID / DIGIKEY_CLIENT_SECRET: DigiKey Product Information API (v4) credentials.
# From your DigiKey developer app (https://developer.digikey.com). This app requires the
# 3-legged authorization-code flow (not client_credentials) — after setting these, run
# `npm run digikey:authorize` once to mint DIGIKEY_REFRESH_TOKEN below via a browser login.
# 1,000 lookups/day tracked in pricing_api_usage.
DIGIKEY_CLIENT_ID="MY_DIGIKEY_CLIENT_ID"
DIGIKEY_CLIENT_SECRET="MY_DIGIKEY_CLIENT_SECRET"

# DIGIKEY_REDIRECT_URI: Must exactly match a redirect URI registered on your DigiKey app.
DIGIKEY_REDIRECT_URI="http://localhost:8080/callback"

# DIGIKEY_REFRESH_TOKEN: Written automatically by `npm run digikey:authorize`. Leave blank —
# the server rotates and re-persists this on every token refresh.
DIGIKEY_REFRESH_TOKEN=

# DIGIKEY_LOCALE_*: Site/currency DigiKey returns pricing in.
DIGIKEY_LOCALE_SITE="ZA"
DIGIKEY_LOCALE_LANGUAGE="en"
DIGIKEY_LOCALE_CURRENCY="ZAR"
DIGIKEY_LOCALE_SHIP_TO_COUNTRY="ZA"

# MOUSER_API_KEY: Mouser Search API key (https://www.mouser.com/api-search/).
# 1,000 lookups/day tracked in pricing_api_usage.
MOUSER_API_KEY="MY_MOUSER_API_KEY"

# LCSC_IMPORT_TOKEN: Shared secret your LCSC scraping script sends as a Bearer token when
# POSTing scraped prices to /api/pricing/lcsc/import. Generate any random string.
LCSC_IMPORT_TOKEN="MY_LCSC_IMPORT_TOKEN"
